# PRODUCTION reference (Railway → service Variables). Secrets are set in the hosting dashboard / Key Vault,
# never committed. See docs/DEPLOY-RAILWAY.md.
NODE_ENV=production
# or "demo" for a public demo (then DEMO_PASSWORD + DEMO_AUTH_SECRET)
AUTH_MODE=entra
DEMO_PASSWORD=
DEMO_AUTH_SECRET=

ANTHROPIC_API_KEY=
LLM_MAIN_MODEL=claude-haiku-5-5
LLM_LIGHT_MODEL=claude-haiku-5-5
LLM_MAIN_EFFORT=medium
LLM_PER_USER_DAILY_USD=0.05
LLM_GLOBAL_DAILY_USD=5

ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=api://food-ordering
ENTRA_SPA_CLIENT_ID=
ENTRA_API_SCOPE=api://food-ordering/Orders.ReadWrite

ALGOLIA_APP_ID=
ALGOLIA_SEARCH_KEY=

# Railway: ${{Redis.REDIS_URL}}
REDIS_URL=
# Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# npm run dev:keys -- --print
CONFIRMATION_SIGNING_KEY_PEM=
WEB_DIST_DIR=../frontend/dist
ACS_EMAIL_CONNECTION_STRING=
ACS_EMAIL_SENDER=DoNotReply@order.example.jp

SLOT_RULES_STRICT=true
PAYMENT_PROVIDER=demo
INVOICE_ISSUER_NAME=
INVOICE_ISSUER_REG_NO=
