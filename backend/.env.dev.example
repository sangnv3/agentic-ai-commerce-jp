# LOCAL DEVELOPMENT — copy to .env (git-ignored) and fill in ANTHROPIC_API_KEY. Never commit .env.
DEV_MODE=true
NODE_ENV=development
PORT=8080

# Login: "demo" = shared password, each login gets its own sample customer (used by the web app).
# npm run dev:chat uses "dev:<name>" tokens instead (DEV_MODE only).
AUTH_MODE=demo
DEMO_PASSWORD=demo
DEMO_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef

ANTHROPIC_API_KEY=
LLM_MAIN_MODEL=claude-haiku-5-5
LLM_LIGHT_MODEL=claude-haiku-5-5
LLM_MAIN_EFFORT=medium
LLM_PER_USER_DAILY_USD=0.05
LLM_GLOBAL_DAILY_USD=2

# Algolia: leave empty → the same filters run over the menu table in PostgreSQL.
# With a real app: App ID + *Search* key here; push the menu with the Write key on the command line:
#   ALGOLIA_ADMIN_KEY=<Write API key> npm run algolia:sync      (never store the Write key in this file)
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_KEY=

REDIS_URL=redis://localhost:6380
DATABASE_URL=postgres://agent:agent@localhost:5433/food
CONFIRMATION_SIGNING_KEY_FILE=dev/keys/confirmation-private.pem
WEB_ORIGIN=http://localhost:5173
# Empty → emails are printed in the backend console
ACS_EMAIL_CONNECTION_STRING=

# Ordering rules for local testing: ignore cutoff/preparation time; 12:30 is always full (tests re-planning)
SLOT_RULES_STRICT=false
DEMO_FULL_SLOTS=12:30
PAYMENT_PROVIDER=demo
