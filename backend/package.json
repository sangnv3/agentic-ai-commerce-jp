{
  "name": "agentic-food-ordering-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "dev:migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "dev:seed": "node --env-file=.env --import tsx src/db/seed.ts",
    "dev:chat": "node --env-file=.env --import tsx dev/chat.ts",
    "dev:keys": "node --import tsx dev/genKeys.ts",
    "algolia:sync": "node --env-file=.env --import tsx src/search/syncAlgolia.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node dist/db/migrate.js",
    "seed": "node dist/db/seed.js",
    "algolia:sync:prod": "node dist/search/syncAlgolia.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dev.json",
    "test": "node --import tsx --test src/pricing/tax.test.ts",
    "predeploy": "node dist/db/migrate.js && node dist/db/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@azure/communication-email": "^1.0.0",
    "algoliasearch": "^5.20.0",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.6"
  }
}
